# Kopiera till .env.local (checkas inte in). Utan värden är realtidskällorna avstängda och appen visar tidtabell.
# OBS: allt med VITE_ byggs in i den publika sidan. Lägg aldrig en riktig nyckel här; låt en lokal proxy hålla den.

# Framtida officiell feed (GTFS-Realtime som JSON), se src/realtime/official.ts
VITE_RT_OFFICIAL_URL=
VITE_RT_OFFICIAL_KEY=
VITE_RT_OFFICIAL_KEY_HEADER=

# Linjestatus i StatusSource-formatet, se src/realtime/status.ts
VITE_RT_STATUS_URL=
VITE_RT_STATUS_KEY=
VITE_RT_STATUS_KEY_HEADER=
